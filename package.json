{
  "name": "notary",
  "private": true,
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "schema:generate": "turbo run schema:generate api:generate fixtures:generate",
    "schema:check": "turbo run schema:check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.8"
  }
}
