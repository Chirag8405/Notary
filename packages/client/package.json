{
  "name": "@notary/client",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Typed REST client (openapi-typescript) and Zod-validated WebSocket event client",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts"
  },
  "scripts": {
    "api:generate": "openapi-typescript openapi.json -o src/generated/api.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@notary/schema": "workspace:*",
    "openapi-fetch": "0.17.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@notary/config-eslint": "workspace:*",
    "@notary/config-typescript": "workspace:*",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "eslint": "10.12.0",
    "openapi-typescript": "7.13.0",
    "react": "19.3.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
