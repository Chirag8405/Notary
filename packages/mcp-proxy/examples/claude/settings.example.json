{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync notary-mcp-proxy hook pre-tool-use --policy packages/mcp-proxy/examples/claude/guard.json"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync notary-mcp-proxy hook user-prompt-submit",
            "timeout": 28
          }
        ]
      }
    ]
  }
}
