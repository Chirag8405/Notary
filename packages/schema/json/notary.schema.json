        },
        "max_egress_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "max_spend_cents": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_effects",
        "max_spend_cents",
        "max_egress_bytes",
        "max_call_amount_cents",
        "max_approvals"
      ],
      "title": "EffectBudget",
      "type": "object"
    },
    "EffectExecuted": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "type": "string"
        },
        "lane": {
          "enum": [
            "undefended",
