        },
        "summary": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "type": {
          "const": "effect_executed",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "lane",
        "seq",
        "type",
        "call_id",
