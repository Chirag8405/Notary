    "ExpectedOutcome": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "enum": [
                "STEP_PASS",
                "READ_ONLY_UNGATED",
                "SCOPE_TOOL_NOT_IN_CONTRACT",
                "SCOPE_MANIFEST_MISMATCH",
                "SCOPE_PARAM_NOT_IN_CONTRACT",
                "IRREVERSIBLE_NOT_AUTHORIZED",
                "ORIGIN_UNTRUSTED",
                "ORIGIN_UNSOURCED",
                "ORIGIN_LITERAL_MISMATCH",
                "ORIGIN_SOURCE_MISMATCH",
                "LEDGER_EXACT_MATCH",
                "LEDGER_LOOKALIKE",
                "LEDGER_NOVEL_ESCALATE",
                "LEDGER_NOT_FOUND",
                "CONF_READER_VIOLATION",
                "CONF_URL_NOT_ALLOWED",
                "CONF_CONTEXT_ESCALATE",
                "BUDGET_AMOUNT",
                "BUDGET_SENDS",
                "BUDGET_EGRESS_BYTES",
                "BUDGET_APPROVALS_EXHAUSTED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "deciding_check": {
          "anyOf": [
            {
              "enum": [
                "scope",
                "irreversibility",
                "origin",
                "corroboration",
                "confidentiality",
                "budget"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "verdict": {
          "enum": [
            "ALLOW",
            "ESCALATE",
            "BLOCK"
          ],
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "deciding_check",
        "code"
      ],
      "title": "ExpectedOutcome",
      "type": "object"
    },
