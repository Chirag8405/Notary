{
  "$defs": {
    "ArenaStartCommand": {
      "additionalProperties": false,
      "description": "Attacker arena: an LLM attacker iterates `rounds` per lane.",
      "properties": {
        "lanes": {
          "items": {
            "enum": [
              "undefended",
              "classifier",
              "notary"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "rounds": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "scenario": {
          "type": "string"
        },
        "seed": {
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "arena_start",
          "type": "string"
        }
      },
      "required": [
        "type",
        "scenario",
        "rounds",
        "lanes",
        "seed"
      ],
      "title": "ArenaStartCommand",
      "type": "object"
    },
    "AttackCase": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "instruction_override",
            "authority_impersonation",
            "data_only_poisoning",
            "action_induction",
            "exfiltration",
            "staged_long_horizon",
            "obfuscation",
            "lookalike",
            "trust_laundering",
            "tool_poisoning",
            "approval_phishing",
            "side_channel",
            "text_to_text_deception",
            "denial_of_utility"
          ],
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/ExpectedOutcome"
        },
        "id": {
          "enum": [
            "A1",
            "A2",
            "A3",
            "A4",
            "A5",
            "A6",
            "A7",
            "A8",
            "A9",
            "A10",
            "A11",
            "A12",
            "A13",
            "A14"
          ],
          "type": "string"
        },
        "payload": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "category",
        "title",
        "payload",
        "expected"
      ],
      "title": "AttackCase",
      "type": "object"
    },
    "AuditEntry": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "$ref": "#/$defs/Event"
        },
        "hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "index": {
          "minimum": 0,
          "type": "integer"
        },
        "prev_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "index",
        "prev_hash",
        "hash",
        "event"
      ],
      "title": "AuditEntry",
      "type": "object"
    },
    "CallProposed": {
      "additionalProperties": false,
      "properties": {
        "lane": {
          "enum": [
            "undefended",
            "classifier",
            "notary"
          ],
          "type": "string"
        },
        "proposal": {
          "$ref": "#/$defs/ToolCallProposal"
        },
        "run_id": {
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "call_proposed",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "lane",
        "seq",
        "type",
        "proposal"
      ],
      "title": "CallProposed",
      "type": "object"
    },
    "Command": {
      "anyOf": [
        {
          "$ref": "#/$defs/EndorsementDecisionCommand"
        },
        {
          "$ref": "#/$defs/HijackedToolCallCommand"
        },
        {
          "$ref": "#/$defs/PoisonWorldCommand"
        },
        {
          "$ref": "#/$defs/ArenaStartCommand"
        }
      ],
      "discriminator": {
        "mapping": {
          "arena_start": "#/$defs/ArenaStartCommand",
          "endorsement_decision": "#/$defs/EndorsementDecisionCommand",
          "hijacked_tool_call": "#/$defs/HijackedToolCallCommand",
          "poison_world": "#/$defs/PoisonWorldCommand"
        },
        "propertyName": "type"
      },
      "title": "Command"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "diff_card": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiffCard"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "type": "array"
        },
        "verdict": {
          "enum": [
            "ALLOW",
            "ESCALATE",
            "BLOCK"
          ],
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "reasons",
        "diff_card"
      ],
      "title": "Decision",
      "type": "object"
    },
    "DecisionMade": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "lane": {
          "enum": [
            "undefended",
            "classifier",
            "notary"
          ],
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "decision_made",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "lane",
        "seq",
        "type",
        "call_id",
        "decision"
      ],
      "title": "DecisionMade",
      "type": "object"
    },
    "DiffCard": {
      "additionalProperties": false,
      "properties": {
        "rows": {
          "items": {
            "$ref": "#/$defs/DiffRow"
          },
          "type": "array"
        }
      },
      "required": [
        "rows"
      ],
      "title": "DiffCard",
      "type": "object"
    },
    "DiffRow": {
      "additionalProperties": false,
      "description": "One parameter of the proposed call, rendered from its label.",
      "properties": {
        "differing_positions": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "integrity": {
          "enum": [
            "trusted",
            "untrusted",
            "endorsed"
          ],
          "type": "string"
        },
        "nearest_ledger_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "param": {
          "type": "string"
        },
        "preview": {
          "type": "string"
        },
        "value_id": {
          "type": "string"
        }
      },
      "required": [
        "param",
        "value_id",
        "origin",
        "integrity",
        "preview",
        "nearest_ledger_value",
        "differing_positions"
      ],
      "title": "DiffRow",
      "type": "object"
    },
    "EffectBudget": {
