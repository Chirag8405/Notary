{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "lane": {
      "enum": [
        "undefended",
        "classifier",
        "notary"
      ],
      "type": "string"
    },
    "outcome": {
      "enum": [
        "completed",
        "blocked",
        "error"
      ],
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "seq": {
      "minimum": 0,
      "type": "integer"
    },
    "summary": {
      "type": "string"
    },
    "type": {
      "const": "run_finished",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "lane",
    "seq",
    "type",
    "outcome",
    "summary"
  ],
  "title": "RunFinished",
  "type": "object"
}
