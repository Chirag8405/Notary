{
  "$defs": {
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "reasons": {
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "type": "array"
        },
        "verdict": {
          "enum": [
            "ALLOW",
            "ESCALATE",
            "BLOCK"
          ],
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "reasons"
      ],
      "title": "Decision",
      "type": "object"
    },
    "Reason": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "enum": [
            "scope",
            "irreversibility",
            "origin",
            "corroboration",
            "confidentiality",
            "budget"
          ],
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "pass",
            "escalate",
            "fail"
          ],
          "type": "string"
        }
      },
      "required": [
        "check",
        "outcome",
        "detail"
      ],
      "title": "Reason",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "call_id": {
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "run_id": {
      "type": "string"
    },
    "seq": {
      "minimum": 0,
      "type": "integer"
    },
    "type": {
      "const": "decision_made",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "seq",
    "type",
    "call_id",
    "decision"
  ],
  "title": "DecisionMade",
  "type": "object"
}
