        "authorized_irreversible": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "budget": {
          "$ref": "#/$defs/EffectBudget"
        },
        "contract_id": {
          "type": "string"
        },
        "egress_hosts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "user_intent": {
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "user_intent",
        "allowed_tools",
        "budget",
        "egress_hosts",
        "authorized_irreversible"
      ],
      "title": "IntentContract",
      "type": "object"
    },
    "InvariantResult": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "type": "string"
        },
        "id": {
          "enum": [
            "I1",
            "I2",
            "I3",
            "I4",
            "I5",
            "I6"
          ],
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "passed",
        "detail"
      ],
      "title": "InvariantResult",
      "type": "object"
    },
    "Label": {
      "additionalProperties": false,
      "properties": {
        "integrity": {
          "enum": [
            "trusted",
            "untrusted",
            "endorsed"
          ],
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "readers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "span_pointer": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpanPointer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "origin",
        "integrity",
        "readers",
        "span_pointer"
      ],
      "title": "Label",
      "type": "object"
    },
    "LedgerMarker": {
      "additionalProperties": false,
      "description": "Parameter must resolve to an entry of the named ledger.",
      "properties": {
        "kind": {
          "const": "ledger",
