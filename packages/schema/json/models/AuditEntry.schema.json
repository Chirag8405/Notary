{
  "$defs": {
    "CallProposed": {
      "additionalProperties": false,
      "properties": {
        "lane": {
          "enum": [
            "undefended",
            "classifier",
            "notary"
          ],
          "type": "string"
        },
        "proposal": {
          "$ref": "#/$defs/ToolCallProposal"
        },
        "run_id": {
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "call_proposed",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "lane",
        "seq",
        "type",
        "proposal"
      ],
      "title": "CallProposed",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "diff_card": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiffCard"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "type": "array"
        },
        "verdict": {
          "enum": [
            "ALLOW",
            "ESCALATE",
            "BLOCK"
          ],
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "reasons",
        "diff_card"
      ],
      "title": "Decision",
      "type": "object"
    },
    "DecisionMade": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "lane": {
          "enum": [
            "undefended",
            "classifier",
            "notary"
          ],
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "decision_made",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "lane",
        "seq",
        "type",
        "call_id",
        "decision"
      ],
      "title": "DecisionMade",
      "type": "object"
    },
    "DiffCard": {
      "additionalProperties": false,
      "properties": {
        "rows": {
          "items": {
            "$ref": "#/$defs/DiffRow"
          },
          "type": "array"
        }
      },
      "required": [
        "rows"
      ],
      "title": "DiffCard",
      "type": "object"
    },
    "DiffRow": {
      "additionalProperties": false,
      "description": "One parameter of the proposed call, rendered from its label.",
      "properties": {
        "differing_positions": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "integrity": {
          "enum": [
            "trusted",
            "untrusted",
            "endorsed"
          ],
          "type": "string"
        },
        "nearest_ledger_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "param": {
          "type": "string"
        },
        "preview": {
          "type": "string"
        },
        "value_id": {
          "type": "string"
        }
      },
      "required": [
        "param",
        "value_id",
        "origin",
        "integrity",
        "preview",
        "nearest_ledger_value",
        "differing_positions"
      ],
      "title": "DiffRow",
      "type": "object"
    },
    "EffectBudget": {
      "additionalProperties": false,
      "properties": {
        "max_approvals": {
          "minimum": 0,
          "type": "integer"
        },
        "max_call_amount_cents": {
          "minimum": 0,
          "type": "integer"
        },
        "max_effects": {
          "minimum": 0,
          "type": "integer"
        },
        "max_egress_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "max_spend_cents": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_effects",
        "max_spend_cents",
        "max_egress_bytes",
        "max_call_amount_cents",
        "max_approvals"
      ],
      "title": "EffectBudget",
      "type": "object"
    },
    "EffectExecuted": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "type": "string"
        },
        "lane": {
          "enum": [
            "undefended",
            "classifier",
            "notary"
          ],
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "type": "integer"
        },
        "summary": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "type": {
          "const": "effect_executed",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "lane",
        "seq",
        "type",
        "call_id",
        "tool",
        "summary"
      ],
      "title": "EffectExecuted",
      "type": "object"
    },
    "EmailOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "email",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "EmailOrigin",
      "type": "object"
    },
    "EndorseMarker": {
      "additionalProperties": false,
      "description": "Parameter may be untrusted but only after explicit human endorsement.",
      "properties": {
        "kind": {
          "const": "endorse",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "EndorseMarker",
      "type": "object"
    },
    "Endorsement": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "type": "string"
        },
        "card": {
          "$ref": "#/$defs/DiffCard"
        },
        "endorsement_id": {
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ],
          "type": "string"
        }
      },
      "required": [
        "endorsement_id",
        "call_id",
        "card",
        "status",
        "sequence"
      ],
      "title": "Endorsement",
      "type": "object"
    },
    "EndorsementRequested": {
      "additionalProperties": false,
      "properties": {
        "endorsement": {
          "$ref": "#/$defs/Endorsement"
        },
        "lane": {
          "enum": [
            "undefended",
            "classifier",
            "notary"
          ],
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "endorsement_requested",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "lane",
        "seq",
        "type",
        "endorsement"
      ],
      "title": "EndorsementRequested",
      "type": "object"
    },
    "EndorsementResolved": {
      "additionalProperties": false,
      "description": "The end of an escalation, appended right after the answer and before anything it causes.",
      "properties": {
        "call_id": {
          "type": "string"
        },
        "endorsement_id": {
          "type": "string"
        },
        "lane": {
          "enum": [
            "undefended",
            "classifier",
            "notary"
          ],
          "type": "string"
        },
        "outcome": {
          "enum": [
            "approved",
            "rejected",
            "replaced",
            "timed_out",
            "cancelled"
          ],
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "endorsement_resolved",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "lane",
        "seq",
        "type",
        "endorsement_id",
        "call_id",
        "outcome"
      ],
      "title": "EndorsementResolved",
      "type": "object"
    },
    "Event": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStarted"
        },
        {
          "$ref": "#/$defs/ValueLabeled"
        },
        {
          "$ref": "#/$defs/CallProposed"
        },
        {
          "$ref": "#/$defs/DecisionMade"
        },
        {
          "$ref": "#/$defs/EndorsementRequested"
        },
        {
          "$ref": "#/$defs/EndorsementResolved"
        },
        {
          "$ref": "#/$defs/EffectExecuted"
        },
        {
          "$ref": "#/$defs/OracleUpdated"
        },
        {
          "$ref": "#/$defs/RunFinished"
        }
      ],
      "discriminator": {
        "mapping": {
          "call_proposed": "#/$defs/CallProposed",
          "decision_made": "#/$defs/DecisionMade",
          "effect_executed": "#/$defs/EffectExecuted",
          "endorsement_requested": "#/$defs/EndorsementRequested",
          "endorsement_resolved": "#/$defs/EndorsementResolved",
          "oracle_updated": "#/$defs/OracleUpdated",
          "run_finished": "#/$defs/RunFinished",
          "run_started": "#/$defs/RunStarted",
          "value_labeled": "#/$defs/ValueLabeled"
        },
        "propertyName": "type"
      },
      "title": "Event"
    },
    "FileOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "file",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "FileOrigin",
      "type": "object"
    },
    "FreeMarker": {
      "additionalProperties": false,
      "description": "Parameter is unconstrained by the contract.",
      "properties": {
        "kind": {
          "const": "free",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "FreeMarker",
      "type": "object"
    },
    "IntentContract": {
      "additionalProperties": false,
      "properties": {
        "allowed_tools": {
