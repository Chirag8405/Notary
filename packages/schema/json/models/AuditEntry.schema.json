            }
          ]
        },
        "contract": {
          "$ref": "#/$defs/IntentContract"
        },
        "lane": {
          "enum": [
            "undefended",
            "classifier",
            "notary"
          ],
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "scenario": {
          "type": "string"
        },
        "seq": {
          "minimum": 0,
