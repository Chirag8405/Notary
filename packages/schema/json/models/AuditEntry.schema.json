      ],
      "title": "LedgerMarker",
      "type": "object"
    },
    "LedgerOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ledger",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "LedgerOrigin",
      "type": "object"
    },
    "LiteralMarker": {
      "additionalProperties": false,
