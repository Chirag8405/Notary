          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            }
          ]
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "LiteralMarker",
      "type": "object"
    },
    "LlmOrigin": {
      "additionalProperties": false,
      "properties": {
        "context_readers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "const": "llm",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "context_readers"
      ],
      "title": "LlmOrigin",
      "type": "object"
    },
    "Marker": {
      "anyOf": [
        {
          "$ref": "#/$defs/LiteralMarker"
        },
        {
          "$ref": "#/$defs/NamedSourceMarker"
        },
        {
          "$ref": "#/$defs/LedgerMarker"
        },
        {
          "$ref": "#/$defs/EndorseMarker"
        },
        {
          "$ref": "#/$defs/FreeMarker"
        }
      ],
      "discriminator": {
        "mapping": {
          "endorse": "#/$defs/EndorseMarker",
          "free": "#/$defs/FreeMarker",
          "ledger": "#/$defs/LedgerMarker",
          "literal": "#/$defs/LiteralMarker",
          "named_source": "#/$defs/NamedSourceMarker"
        },
        "propertyName": "kind"
      },
      "title": "Marker"
    },
    "NamedSourceMarker": {
      "additionalProperties": false,
      "description": "Parameter must come from a named source (e.g. a contact book entry).",
      "properties": {
        "kind": {
          "const": "named_source",
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source"
      ],
      "title": "NamedSourceMarker",
      "type": "object"
    },
    "OracleResult": {
      "additionalProperties": false,
