    "Origin": {
      "anyOf": [
        {
          "$ref": "#/$defs/UserOrigin"
        },
        {
          "$ref": "#/$defs/ToolOrigin"
        },
        {
          "$ref": "#/$defs/EmailOrigin"
        },
        {
          "$ref": "#/$defs/FileOrigin"
        },
        {
          "$ref": "#/$defs/WebOrigin"
        },
        {
          "$ref": "#/$defs/LedgerOrigin"
        },
        {
          "$ref": "#/$defs/LlmOrigin"
        }
      ],
      "discriminator": {
        "mapping": {
          "email": "#/$defs/EmailOrigin",
          "file": "#/$defs/FileOrigin",
          "ledger": "#/$defs/LedgerOrigin",
          "llm": "#/$defs/LlmOrigin",
          "tool": "#/$defs/ToolOrigin",
          "user": "#/$defs/UserOrigin",
          "web": "#/$defs/WebOrigin"
        },
        "propertyName": "kind"
      },
      "title": "Origin"
    },
    "Reason": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "enum": [
            "scope",
            "irreversibility",
            "origin",
            "corroboration",
            "confidentiality",
            "budget"
          ],
          "type": "string"
        },
        "code": {
          "enum": [
            "STEP_PASS",
            "READ_ONLY_UNGATED",
            "SCOPE_TOOL_NOT_IN_CONTRACT",
            "SCOPE_MANIFEST_MISMATCH",
            "SCOPE_PARAM_NOT_IN_CONTRACT",
            "IRREVERSIBLE_NOT_AUTHORIZED",
            "ORIGIN_UNTRUSTED",
            "ORIGIN_UNSOURCED",
            "ORIGIN_LITERAL_MISMATCH",
            "ORIGIN_SOURCE_MISMATCH",
            "LEDGER_EXACT_MATCH",
            "LEDGER_LOOKALIKE",
            "LEDGER_NOVEL_ESCALATE",
            "LEDGER_NOT_FOUND",
            "CONF_READER_VIOLATION",
            "CONF_URL_NOT_ALLOWED",
            "CONF_CONTEXT_ESCALATE",
            "BUDGET_AMOUNT",
            "BUDGET_SENDS",
            "BUDGET_EGRESS_BYTES",
            "BUDGET_APPROVALS_EXHAUSTED",
            "BUDGET_ESCALATIONS_EXHAUSTED"
          ],
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "pass",
            "escalate",
            "fail"
          ],
          "type": "string"
        }
      },
      "required": [
        "check",
        "outcome",
        "code",
        "detail"
      ],
      "title": "Reason",
      "type": "object"
    },
    "RunFinished": {
      "additionalProperties": false,
      "properties": {
        "lane": {
          "enum": [
            "undefended",
            "classifier",
            "notary"
          ],
          "type": "string"
        },
        "outcome": {
          "enum": [
            "completed",
            "blocked",
            "error"
          ],
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "type": "integer"
        },
        "summary": {
          "type": "string"
        },
        "type": {
          "const": "run_finished",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "lane",
        "seq",
        "type",
        "outcome",
        "summary"
      ],
      "title": "RunFinished",
      "type": "object"
