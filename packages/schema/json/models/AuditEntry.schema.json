          "minimum": 0,
          "type": "integer"
        },
        "source_value_id": {
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "source_value_id",
        "start",
        "end"
      ],
      "title": "SpanPointer",
      "type": "object"
    },
