{
  "$defs": {
    "ArenaStartCommand": {
      "additionalProperties": false,
      "description": "Attacker arena: an LLM attacker iterates `rounds` per lane.",
      "properties": {
        "lanes": {
          "items": {
            "enum": [
              "undefended",
              "classifier",
              "notary"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "rounds": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "scenario": {
          "type": "string"
        },
        "seed": {
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "arena_start",
          "type": "string"
        }
      },
      "required": [
        "type",
        "scenario",
        "rounds",
        "lanes",
        "seed"
      ],
      "title": "ArenaStartCommand",
      "type": "object"
    },
    "EndorsementDecisionCommand": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "approve",
            "reject",
            "use_nearest"
          ],
          "type": "string"
        },
        "endorsement_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "type": {
          "const": "endorsement_decision",
          "type": "string"
        }
      },
      "required": [
        "type",
        "run_id",
        "endorsement_id",
        "decision"
      ],
      "title": "EndorsementDecisionCommand",
      "type": "object"
    },
    "HijackedToolCallCommand": {
      "additionalProperties": false,
      "description": "Hijacked Mode: a judge submits a raw tool call; no LLM is involved.",
      "properties": {
        "args": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "call_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "type": {
          "const": "hijacked_tool_call",
          "type": "string"
        }
      },
      "required": [
        "type",
        "run_id",
        "call_id",
        "tool",
        "args"
      ],
      "title": "HijackedToolCallCommand",
      "type": "object"
    },
    "PoisonWorldCommand": {
      "additionalProperties": false,
      "description": "Poison-the-world: choose vector, payload and task, then run on the chosen lanes.",
      "properties": {
        "lanes": {
          "items": {
            "enum": [
              "undefended",
              "classifier",
              "notary"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "payload": {
          "type": "string"
        },
        "scenario": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "type": {
          "const": "poison_world",
          "type": "string"
        },
        "vector": {
          "enum": [
            "email",
            "file",
            "web",
            "calendar",
            "slack",
            "tool_description"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "scenario",
        "vector",
        "payload",
        "task",
        "lanes"
      ],
      "title": "PoisonWorldCommand",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/EndorsementDecisionCommand"
    },
    {
      "$ref": "#/$defs/HijackedToolCallCommand"
    },
    {
      "$ref": "#/$defs/PoisonWorldCommand"
    },
    {
      "$ref": "#/$defs/ArenaStartCommand"
    }
  ],
  "discriminator": {
    "mapping": {
      "arena_start": "#/$defs/ArenaStartCommand",
      "endorsement_decision": "#/$defs/EndorsementDecisionCommand",
      "hijacked_tool_call": "#/$defs/HijackedToolCallCommand",
      "poison_world": "#/$defs/PoisonWorldCommand"
    },
    "propertyName": "type"
  },
  "title": "Command"
}
