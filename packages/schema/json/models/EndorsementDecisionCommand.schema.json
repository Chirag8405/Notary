{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "enum": [
        "approve",
        "reject",
        "use_nearest"
      ],
      "type": "string"
    },
    "endorsement_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "type": {
      "const": "endorsement_decision",
      "type": "string"
    }
  },
  "required": [
    "type",
    "run_id",
    "endorsement_id",
    "decision"
  ],
  "title": "EndorsementDecisionCommand",
  "type": "object"
}
