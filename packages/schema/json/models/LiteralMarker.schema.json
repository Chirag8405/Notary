{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Parameter must equal this exact value.",
  "properties": {
    "kind": {
      "const": "literal",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        }
      ]
    }
  },
  "required": [
    "kind",
    "value"
  ],
  "title": "LiteralMarker",
  "type": "object"
}
