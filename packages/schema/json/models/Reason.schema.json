{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "check": {
      "enum": [
        "scope",
        "irreversibility",
        "origin",
        "corroboration",
        "confidentiality",
        "budget"
      ],
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "pass",
        "escalate",
        "fail"
      ],
      "type": "string"
    }
  },
  "required": [
    "check",
    "outcome",
    "detail"
  ],
  "title": "Reason",
  "type": "object"
}
