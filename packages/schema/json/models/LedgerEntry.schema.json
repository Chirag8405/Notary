{
  "$defs": {
    "EmailOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "email",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "EmailOrigin",
      "type": "object"
    },
    "FileOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "file",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "FileOrigin",
      "type": "object"
    },
    "Label": {
      "additionalProperties": false,
      "properties": {
        "integrity": {
          "enum": [
            "trusted",
            "untrusted",
            "endorsed"
          ],
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "readers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "span_pointer": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpanPointer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "origin",
        "integrity",
        "readers",
        "span_pointer"
      ],
      "title": "Label",
      "type": "object"
    },
    "LedgerOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ledger",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "LedgerOrigin",
      "type": "object"
    },
    "LedgerSource": {
      "anyOf": [
        {
          "$ref": "#/$defs/UserAuthoredSource"
        },
        {
          "$ref": "#/$defs/UserEndorsedSource"
        }
      ],
      "discriminator": {
        "mapping": {
          "user_authored": "#/$defs/UserAuthoredSource",
          "user_endorsed": "#/$defs/UserEndorsedSource"
        },
        "propertyName": "kind"
      },
      "title": "LedgerSource"
    },
    "LlmOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "llm",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "LlmOrigin",
      "type": "object"
    },
    "Origin": {
      "anyOf": [
        {
          "$ref": "#/$defs/UserOrigin"
        },
        {
          "$ref": "#/$defs/ToolOrigin"
        },
        {
          "$ref": "#/$defs/EmailOrigin"
        },
        {
          "$ref": "#/$defs/FileOrigin"
        },
        {
          "$ref": "#/$defs/WebOrigin"
        },
        {
          "$ref": "#/$defs/LedgerOrigin"
        },
        {
          "$ref": "#/$defs/LlmOrigin"
        }
      ],
      "discriminator": {
        "mapping": {
          "email": "#/$defs/EmailOrigin",
          "file": "#/$defs/FileOrigin",
          "ledger": "#/$defs/LedgerOrigin",
          "llm": "#/$defs/LlmOrigin",
          "tool": "#/$defs/ToolOrigin",
          "user": "#/$defs/UserOrigin",
          "web": "#/$defs/WebOrigin"
        },
        "propertyName": "kind"
      },
      "title": "Origin"
    },
    "SpanPointer": {
      "additionalProperties": false,
      "description": "Points at the span of a source value that a derived value was taken from.",
      "properties": {
        "end": {
          "minimum": 0,
          "type": "integer"
        },
        "source_value_id": {
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "source_value_id",
        "start",
        "end"
      ],
      "title": "SpanPointer",
      "type": "object"
    },
    "ToolOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "tool",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "ToolOrigin",
      "type": "object"
    },
    "UserAuthoredSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "user_authored",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "UserAuthoredSource",
      "type": "object"
    },
    "UserEndorsedSource": {
      "additionalProperties": false,
      "properties": {
        "endorsement_id": {
          "type": "string"
        },
        "kind": {
          "const": "user_endorsed",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "endorsement_id"
      ],
      "title": "UserEndorsedSource",
      "type": "object"
    },
    "UserOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "user",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "UserOrigin",
      "type": "object"
    },
    "ValueRef": {
      "additionalProperties": false,
      "description": "A labeled handle to a value. Raw content never travels through the monitor.",
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Label"
        }
      },
      "required": [
        "id",
        "label",
        "content_hash"
      ],
      "title": "ValueRef",
      "type": "object"
    },
    "WebOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "web",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "WebOrigin",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical": {
      "type": "string"
    },
    "entry_id": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "ledger": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/LedgerSource"
    },
    "unit": {
      "enum": [
        "iban",
        "email",
        "url_host",
        "amount",
        "identifier"
      ],
      "type": "string"
    },
    "value": {
      "$ref": "#/$defs/ValueRef"
    }
  },
  "required": [
    "entry_id",
    "ledger",
    "key",
    "value",
    "unit",
    "canonical",
    "source"
  ],
  "title": "LedgerEntry",
  "type": "object"
}
