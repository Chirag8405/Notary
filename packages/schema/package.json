{
  "name": "@notary/schema",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Committed JSON Schemas from notary_core plus GENERATED TS types and Zod validators",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "schema:generate": "tsx scripts/generate.ts",
    "schema:check": "node ../../scripts/schema-check.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@notary/config-eslint": "workspace:*",
    "@notary/config-typescript": "workspace:*",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "json-schema-to-typescript": "16.0.0",
    "json-schema-to-zod": "2.8.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
